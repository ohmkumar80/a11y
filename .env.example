# Copy to .env (make env does this). Values here are for LOCAL DEVELOPMENT ONLY.

# --- Postgres ---------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=postgres-dev-only
# Owns tables, runs Alembic migrations. Subject to RLS (FORCE ROW LEVEL SECURITY).
A11Y_OWNER_PASSWORD=owner-dev-only
# Used by the API/workers. NOT the table owner, NOBYPASSRLS.
A11Y_APP_PASSWORD=app-dev-only
# Super Admin cross-tenant role. BYPASSRLS; every use must be written to audit_log.
A11Y_ADMIN_PASSWORD=admin-dev-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=a11y

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage (RustFS, an S3-compatible store, locally) -----------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=s3-dev-only
S3_SECRET_KEY=s3-dev-only-secret
S3_BUCKET=a11y-dev

# --- API --------------------------------------------------------------------
# Generate a real one: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Cookie Secure flag; must be true behind HTTPS.
COOKIE_SECURE=false
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Fernet keys for encrypting admin-entered secrets (AI provider keys etc.), comma-separated; first key
# encrypts, all decrypt (rotation). Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# The value below is public and refused when ENV=production.
A11Y_MASTER_KEYS=Q2OoEdjRtijEf6Bd8VUo4q6_2oBKlFXaQopiFpf0lgc=
ENV=development

# Two-step verification (MFA) for administrators. This is only the STARTING value; admins change it at runtime in
# /admin -> Settings -> auth.mfa. "off" is for development and is refused when ENV=production.
MFA_SUPER_ADMIN_DEFAULT=off
MFA_ORG_ADMIN_DEFAULT=optional

# --- Mail (Mailpit locally: UI on :8025) ------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@a11y.local

# --- Web --------------------------------------------------------------------
# Server-side URL Next.js uses to reach the API.
API_INTERNAL_URL=http://localhost:8000

# --- Host ports (change if something else on your machine already uses them) ---
WEB_PORT=3000
API_PORT=8000
S3_PORT=9000
S3_CONSOLE_PORT=9001
