  "/v1/scans/{scan_id}/findings": {
   "get": {
    "tags": [
     "Scans"
    ],
    "summary": "List a scan's findings",
    "description": "Filter by kind, severity, rule, confidence or page. `group=cluster` groups identical problems found on many pages into one root cause.\n\n**Required scope:** `scans:read`.",
    "operationId": "list_findings_v1_scans__scan_id__findings_get",
    "parameters": [
     {
      "name": "scan_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "format": "uuid",
       "title": "Scan Id"
      }
     },
     {
      "name": "standard",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Standard"
      }
     },
     {
      "name": "kind",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "pattern": "^(violation|needs_review|best_practice)$",
       "default": "violation",
       "title": "Kind"
      }
     },
     {
      "name": "severity",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^(critical|serious|moderate|minor)$"
        },
        {
         "type": "null"
        }
       ],
       "title": "Severity"
      }
     },
     {
      "name": "rule",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 120
        },
        {
         "type": "null"
        }
       ],
       "title": "Rule"
      }
     },
     {
      "name": "page_id",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "uuid"
        },
        {
         "type": "null"
        }
       ],
       "title": "Page Id"
      }
     },
     {
      "name": "confidence",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^(high|medium|low|review)$"
        },
        {
         "type": "null"
        }
       ],
       "title": "Confidence"
      }
     },
     {
      "name": "group",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "pattern": "^(none|cluster)$",
       "default": "none",
       "title": "Group"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 200,
       "minimum": 1,
       "default": 50,
       "title": "Limit"
      }
     },
     {
      "name": "offset",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 0,
       "default": 0,
       "title": "Offset"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/FindingList"
        }
       }
      }
     },
     "401": {
      "description": "The API key is missing, wrong, revoked or expired (`invalid_api_key`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     },
     "403": {
      "description": "The key lacks the required scope (`scope_missing`), or the plan has no API access (`api_not_in_plan`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     },
