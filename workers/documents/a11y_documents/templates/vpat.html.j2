{% extends "_base.html.j2" %}
{% block title %}Accessibility Conformance Report ({{ d.edition_label }}): {{ d.product.get("name") or d.site }}{% endblock %}
{% block running_head %}ACR: {{ d.product.get("name") or d.site }}{% endblock %}
{% block body %}
<header>
  <h1>Accessibility Conformance Report</h1>
  <p>Based on VPAT® 2.5, {{ d.edition_label }}. {% if d.status == "DRAFT" %}<strong>DRAFT: not reviewed or signed off.</strong>{% endif %}</p>
</header>
<main>
<section aria-labelledby="about">
  <h2 id="about">About this report</h2>
  <table>
    <caption>Product and report details</caption>
    <thead><tr><th scope="col">Item</th><th scope="col">Detail</th></tr></thead>
    <tbody>
      <tr><th scope="row">Name of product</th><td>{{ d.product.get("name") or d.site }}</td></tr>
      <tr><th scope="row">Version</th><td>{{ d.product.get("version") or "Not stated" }}</td></tr>
      <tr><th scope="row">Description</th><td>{{ d.product.get("description") or "Not stated" }}</td></tr>
      <tr><th scope="row">Web address evaluated</th><td>{{ d.site }}</td></tr>
      <tr><th scope="row">Report date</th><td>{{ d.report_date }}</td></tr>
      <tr><th scope="row">Prepared for</th><td>{{ d.organization }}</td></tr>
      <tr><th scope="row">Contact</th><td>{{ d.product.get("contact") or "Not stated" }}</td></tr>
      <tr><th scope="row">Notes</th><td>{{ d.product.get("notes") or "None" }}</td></tr>
      <tr><th scope="row">Standard</th><td>{{ d.standard_label }}. {{ d.legal_label }}.</td></tr>
    </tbody>
  </table>
</section>

<section aria-labelledby="status">
  <h2 id="status">Status of this document</h2>
  <div class="notice">
    {% if d.signoff %}
    <p>The conformance levels and remarks in this document were reviewed and confirmed by <strong>{{ d.signoff.name }}</strong> ({{ d.signoff.role }}) on {{ d.signoff.signed_at[:10] }}.</p>
    <p>Statement made at sign-off: {{ d.signoff.statement }}</p>
    {% else %}
    <p><strong>This is a draft.</strong> It has not been reviewed or signed off by a person and must not be shared as a conformance claim.</p>
    {% endif %}
    {% if d.not_evaluated %}<p><strong>This report is incomplete:</strong> {{ d.not_evaluated }} of {{ d.total }} criteria are still "Not Evaluated".</p>{% endif %}
    {% if d.mapping_review == "draft" %}<p>The mapping of this standard to individual criteria has not yet been signed off by an accessibility expert.</p>{% endif %}
    <p>This document contains the WCAG success criteria for web content only. The chapters of {{ d.edition_label }} that apply to software, hardware and documentation are not included.</p>
  </div>
</section>

<section aria-labelledby="methods">
  <h2 id="methods">Evaluation methods used</h2>
  <p>Automated tests: each page was opened in a real browser and tested with {% for k, v in d.engine_versions.items() %}{{ k }} {{ v }}{% if not loop.last %}, {% endif %}{% endfor %} (rule mappings version {{ d.rules_version }}).
  Automated tests cannot establish that a criterion is supported. Where a level other than "Not Evaluated" has no automated evidence behind it, it was set by the person named above.</p>
</section>

<section aria-labelledby="terms">
  <h2 id="terms">Terms used in the conformance level information</h2>
  <table>
    <caption>Conformance levels</caption>
    <thead><tr><th scope="col">Term</th><th scope="col">Meaning</th></tr></thead>
    <tbody>{% for t, m in d.terms %}<tr><th scope="row">{{ t }}</th><td>{{ m }}</td></tr>{% endfor %}</tbody>
  </table>
</section>

{% for t in d.tables %}
<section aria-labelledby="t{{ loop.index }}">
  <h2 id="t{{ loop.index }}">{{ t.title }}</h2>
  <table>
    <caption>{{ t.title }}</caption>
    <thead><tr><th scope="col">Criteria</th><th scope="col">Conformance level</th><th scope="col">Remarks and explanations</th></tr></thead>
    <tbody>
      {% for r in t.rows %}
      <tr><th scope="row">{{ r.clause }} {{ r.name }} (Level {{ r.level }})</th><td>{{ r.conformance }}</td><td>{{ r.remarks }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</section>
{% endfor %}
</main>
<footer><p>VPAT® is a registered service mark of the Information Technology Industry Council (ITI). Generated by a11y.</p></footer>
{% endblock %}
